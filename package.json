{
  "name": "pg-manager",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22.11.0",
    "pnpm": ">=9.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "pnpm --filter @pg/db prisma generate",
    "db:migrate": "pnpm --filter @pg/db prisma migrate dev",
    "db:deploy": "pnpm --filter @pg/db prisma migrate deploy",
    "db:studio": "pnpm --filter @pg/db prisma studio",
    "db:seed": "pnpm --filter @pg/db db:seed",
    "audit": "pnpm audit --audit-level=high",
    "audit:fix": "pnpm audit --fix",
    "security:scan": "pnpm audit --audit-level=moderate && echo 'Run: trivy fs . && gitleaks detect'"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.9",
    "@types/node": "22.9.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-security": "3.0.1",
    "globals": "17.6.0",
    "prettier": "3.3.3",
    "turbo": "2.9.17",
    "typescript": "5.6.3",
    "typescript-eslint": "8.61.0"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.15": "8.5.15"
    }
  }
}
