# Copy to apps/web/.env.local and fill. Never commit .env.local.
# All these also need to be set in Vercel → Project Settings → Environment Variables.

# ─── Auth (self-hosted) ──────────────────────────────────────────────────────
# Secret used to sign the session-cookie JWT (HS256). Keep it private and stable
# across deploys — rotating it invalidates everyone's session. Min 32 chars.
# Generate: openssl rand -base64 48
AUTH_SECRET=change_me_min_32_chars_random_string

# ─── Supabase (Object Storage ONLY) ──────────────────────────────────────────
# Auth + DB no longer use Supabase. These keys are only for Supabase Storage
# (file/photo uploads via apps/web/src/lib/uploads.ts). From Supabase dashboard
# → Project Settings → API. Leave blank if you aren't using uploads yet.
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...your-anon-public-key...
# service_role bypasses RLS — server-only, NEVER ship to browser. Do not prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key...

# ─── Database (Neon Postgres) ────────────────────────────────────────────────
# Neon is serverless Postgres. Create a project and copy the connection strings
# from the Neon Console → your project → "Connect". See NEON_SETUP.md for the
# step-by-step on generating these credentials.
#
# DATABASE_URL  → the POOLED endpoint (host contains "-pooler"). Used at runtime;
#                 required for Vercel's serverless functions which open many
#                 short-lived connections.
# DIRECT_URL    → the DIRECT endpoint (same host WITHOUT "-pooler"). Used only by
#                 Prisma for migrations (`prisma migrate`), which can't run over
#                 the transaction pooler.
#
# Both must keep `?sslmode=require` — Neon only accepts TLS connections.
DATABASE_URL=postgresql://<user>:<password>@ep-<endpoint-id>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require
DIRECT_URL=postgresql://<user>:<password>@ep-<endpoint-id>.<region>.aws.neon.tech/<dbname>?sslmode=require

# ─── Encryption for PII at rest (AES-256-GCM) ────────────────────────────────
# Generate ONCE: openssl rand -hex 32     (must be exactly 64 hex chars)
# This MUST be the same value across all environments — losing it = losing all decrypted PII.
PII_ENCRYPTION_KEY=change_me_64_hex_chars_exactly_for_aes_256_gcm

# ─── Cron secret (protects scheduled endpoints) ──────────────────────────────
# Generate: openssl rand -base64 32
# Vercel sends this as Authorization: Bearer <value> when invoking /api/cron/*
CRON_SECRET=change_me_random_cron_secret

# ─── App URL (used for OAuth redirects + email links) ────────────────────────
# Locally: http://localhost:3000   On Vercel: https://<your>.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Optional: log level ─────────────────────────────────────────────────────
LOG_LEVEL=info
